# Copia este archivo a .env y ajusta si quieres (en otro PC):
#   Linux/macOS/WSL:  cp .env.example .env
#   Windows (CMD):    copy .env.example .env
#   Windows (PS):     Copy-Item .env.example .env
#
# No subas .env a Git (ya está en .gitignore).

# --- MySQL (servicio + acceso desde el host) ---
MYSQL_ROOT_PASSWORD=nudatroot
MYSQL_DATABASE=nudat
MYSQL_USER=nudat
MYSQL_PASSWORD=nudat
# Puerto en tu máquina → 3306 dentro del contenedor
MYSQL_HOST_PORT=3307

# --- App / Jupyter (dentro de la red Docker el host es el nombre del servicio) ---
MYSQL_HOST=mysql
MYSQL_PORT=3306

# --- JupyterLab ---
JUPYTER_TOKEN=nudat
JUPYTER_HOST_PORT=8888

# --- Streamlit ---
STREAMLIT_HOST_PORT=8501
